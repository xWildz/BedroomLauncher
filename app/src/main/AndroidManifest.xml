<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather forecast (Open-Meteo, HTTPS only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the phone link alive while other apps are open, and start it at boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Invisible 2x2 dot that keeps the phone's live video updating on a still screen (only while watching). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Wake-up alarm at an exact time. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets us list and launch TV apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Launcher"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen off, sound on. Invisible layer on top of the playing app; any remote button wakes the picture. -->
        <activity
            android:name=".ScreenOffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.bedroom.launcher.screenoff"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- Talks to the TV chip's backlight switch, in its own process so a vendor crash can't hit the home screen. -->
        <provider
            android:name=".BacklightProvider"
            android:authorities="com.bedroom.launcher.backlight"
            android:exported="false"
            android:process=":picture" />

        <!-- adb / PC panel switch for screen off/on (DUMP is held by the adb shell, not by apps). -->
        <receiver
            android:name=".ScreenControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Lets the phone app see what's playing (title, art) and control it. Reads no notifications.
             Turned on through the TV's adb; undo: cmd notification disallow_listener ... (panel Undo page). -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Phone link keeper (see LinkService.kt). -->
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the phone remote connected while other TV apps are open" />
        </service>
        <receiver android:name=".LinkBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wake-up alarm (internal only). -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />

        <!-- Photo frame slideshow (from the phone, or instead of the screensaver). -->
        <activity
            android:name=".PhotoFrameActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.bedroom.launcher.frame"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Sleep timer alarm (internal only). -->
        <receiver android:name=".SleepReceiver" android:exported="false" />

        <!-- adb-only switch to remove the turn-off permission (DUMP is held by the adb shell, not by apps). -->
        <receiver
            android:name=".AdminControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.bedroom.launcher.REMOVE_ADMIN" />
            </intent-filter>
        </receiver>

        <!-- Lets the sleep timer turn the TV off. Activated only by tools\remote-setup.ps1 -Enable. -->
        <receiver
            android:name=".SleepAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
